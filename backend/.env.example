# Copy to backend/.env. Everything has a working default; only CONTACT_EMAIL should be yours.
CONTACT_EMAIL=you@example.com          # Nominatim usage policy requires a real contact
APP_TZ=Asia/Kolkata
GEOCODE_COUNTRY_CODES=in
SLM_ENABLED=true
SLM_BACKEND=llama_cpp                  # llama_cpp | transformers | none
SLM_REPO=aaronr43210/terrapulse-qwen3-1.7b-GGUF
SLM_FILE=terrapulse-qwen3-1.7b.Q4_K_M.gguf
SLM_BASE_REPO=unsloth/Qwen3-1.7B-GGUF  # used automatically until the fine-tune is published
SLM_BASE_FILE=Qwen3-1.7B-Q4_K_M.gguf
# SLM_LOCAL_PATH=/path/to/model.gguf
WAQI_TOKEN=                             # optional, free from aqicn.org/data-platform/token
OVERPASS_TIMEOUT_S=25
LOG_LEVEL=INFO
